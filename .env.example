# =========================================================================
# FlashFacts â€” Production & Environment Configuration Template (.env.example)
# =========================================================================

# Database Configuration (PostgreSQL / Supabase / Neon / RDS)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/flashfacts

# Cache & Message Queue (Redis / Upstash Redis)
REDIS_URL=redis://localhost:6379/0

# Security & Session Secrets
SECRET_KEY=replace-with-a-strong-random-secret-before-deployment
ALGORITHM=HS256

# Environment & CORS Settings
APP_ENV=development
CORS_ORIGINS=["http://localhost:3000","http://localhost:8000","https://flashfacts.vercel.app"]

# Frontend Public Base URLs
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# OAuth / Dual Authentication (Google Identity Services)
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_oauth_client_secret
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com

# AI Provider Configuration (Optional LLM Integration)
# Options: fallback, openai, gemini, ollama
AI_PROVIDER=fallback
AI_API_KEY=
AI_MODEL=gpt-4o-mini
AI_MAX_INPUT_CHARS=6000
OLLAMA_BASE_URL=http://host.docker.internal:11434

# Ingestion Worker Telemetry & Scraping Rules
INGESTION_ENABLED=true
INGESTION_INTERVAL_MINUTES=30
INGESTION_REQUEST_TIMEOUT=15
INGESTION_MAX_RETRIES=3
INGESTION_RETRY_BACKOFF=1
INGESTION_USER_AGENT=FlashFacts/1.0 (+https://flashfacts.vercel.app)
INGESTION_FRESHNESS_HOURS=72


# AI input limits

# News ingestion
